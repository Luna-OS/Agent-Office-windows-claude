# Nur das, woraus das Image baut (deploy/railway.sh lädt mit angewandter .gitignore hoch, und
# deploy/fly.sh gibt diese Datei an Flys Builder).
target
dist
.git
*.log
node_modules
# Das `COPY . .` des Builds nähme sonst alles im Checkout mit, also bleiben lokale Geheimnisse aus
# dem Image: env-Dateien, Claude Codes Projekteinstellungen, Schlüssel, die Dev-Passwortdatei.
**/.env*
**/.claude
**/.open-agentic-office
**/*.pem
**/*.key
**/id_*
**/pw.txt
